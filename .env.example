# 酒店 PMS 环境变量模板
# Django 不会自动读取 .env；请由 shell、IDE、Docker Compose 或部署平台注入。

DJANGO_ENV=dev
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Shanghai

# mysql / postgresql / sqlite
DJANGO_DB_ENGINE=mysql
DJANGO_DB_NAME=hotel
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306
DJANGO_DB_CONN_MAX_AGE=60

DEFAULT_PROPERTY_CODE=DEFAULT

# 生产环境按 HTTPS 反向代理实际情况设置
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_TRUST_PROXY_SSL=0
