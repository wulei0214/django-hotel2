  "cards": [
    {
      "dot": "cyan",
      "title": "入口与会话",
      "items": [
        "员工与客人共用同一 Django 进程：服务端 HTML 页面 + /api/v1 JSON",
        "PMS 会话 Cookie 按路径拆分，/ 与 /platform/、/admin/ 各走独立会话域",
        "匿名仅开放公开预订页与邀请激活页"
      ]
    },
    {
      "dot": "rose",
      "title": "安全控制",
      "items": [
        "每个业务视图按权限码校验：任职 + 角色授权，缺任职直接拒绝并写审计",
        "公开面限流走 RateLimitCounter 表原子自增，存储异常时 fail-closed 返回 429",
        "写操作与安全拒绝同时落 AuditEvent（append-only 表）与 logs/*.log"
      ]
    },
    {
      "dot": "amber",
      "title": "支付边界",
      "items": [
        "支付意图与回调仅 dev/test 开放，回调按 X-Signature HMAC 验签，生产返回 404",
        "回调区分「渠道资金成功」与「库存是否确认」，库存失败标记补偿",
        "退款走申请 / 审批 / 执行三方分离，同一笔需三个不同账号"
      ]
    },
    {
      "dot": "slate",
      "title": "次级入口",
      "items": [
        "Django Admin（SimpleUI）为超管后台，独立会话 Cookie",
        "/platform/ 权限矩阵与系统信息为平台侧管理面",
        "夜审按营业日过账，重开与 break-glass 需审批或复核"
      ]
    }
  ]
