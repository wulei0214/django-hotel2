  "cards": [
    {
      "dot": "cyan",
      "title": "入口与会话",
      "items": [
        "PMS 业务会话（/）与平台管理会话隔离：两套 Session 互不认证",
        "平台门户与 Django Admin 共享同一个平台 Session，仅靠两个 Path Cookie 别名传递：platform_sessionid @ /platform/、django_admin_sessionid @ /admin/",
        "匿名仅开放公开预订页与邀请激活页"
      ]
    },
    {
      "dot": "rose",
      "title": "安全控制",
      "items": [
        "每个业务视图按权限码校验：任职 + 角色授权，缺任职直接拒绝并写审计",
        "公开面限流走 RateLimitCounter 表原子自增，存储异常时 fail-closed 返回 429",
        "AuditEvent 的只追加不只靠应用层：另有 MySQL 触发器安装命令与校验命令阻止 UPDATE/DELETE"
      ]
    },
    {
      "dot": "amber",
      "title": "缓存边界",
      "items": [
        "开发默认 LocMemCache；DJANGO_ENV=prod 时禁止 LocMem，必须 Redis",
        "缓存一律非权威：故障时降级直查数据库，只损失性能",
        "账单摘要与查重缓存 60 秒 TTL"
      ]
    },
    {
      "dot": "slate",
      "title": "支付与补偿",
      "items": [
        "支付意图与回调仅 dev/test 开放，回调按 X-Signature HMAC 验签，生产返回 404",
        "回调区分「渠道资金成功」与「库存是否确认」，库存失败标记补偿",
        "补偿任务模型已含租约、重试、死信和人工重放；但仓库没有常驻 Worker 进程，见另一张部署图"
      ]
    }
  ]
